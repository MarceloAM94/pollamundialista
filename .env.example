# Plantilla de entorno para Polla Mundialista
# Copia este archivo como .env (para Prisma CLI) y .env.local (para Next.js)

# Pooler de Supabase (Transaction mode, puerto 6543)
# Obtén la URL exacta desde: Supabase > Project Settings > Database > Connection pooler
DATABASE_URL="postgresql://postgres.TU_PROJECT_REF:TU_CONTRASEÑA@aws-1-us-west-2.pooler.supabase.com:6543/postgres?sslmode=require"

# Secreto JWT (genera uno con: openssl rand -base64 32)
JWT_SECRET="cambia-esto-por-un-secreto-seguro-aleatorio-de-32-caracteres"
