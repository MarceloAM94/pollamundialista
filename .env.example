# Polla Mundialista - Variables de Entorno
# Copia este archivo como .env.local y completa los valores

# Conexión a PostgreSQL (Supabase)
# Ve a https://supabase.com > Project Settings > Database > Connection string
# Ejemplo: postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:tu-contraseña@db.tu-proyecto.supabase.co:5432/postgres"

# Secreto para firmar JWT (cambiar obligatoriamente en producción)
# Genera uno con: openssl rand -base64 32
JWT_SECRET="cambia-esto-por-un-secreto-seguro-aleatorio-de-32-caracteres"
