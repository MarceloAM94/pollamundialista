generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoPartido {
  PROGRAMADO
  BLOQUEADO
  EN_VIVO
  FINALIZADO
  PROCESADO
}

enum EstadoSistema {
  PRE_TORNEO
  FASE_GRUPOS_ABIERTA
  TRANSICION
  FASE_MATAMATA_ABIERTA
  TORNEO_FINALIZADO
}

model Usuario {
  id           Int         @id @default(autoincrement())
  username     String      @unique
  passwordHash String
  nombre       String
  isAdmin      Boolean     @default(false)
  activo       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  pronosticos  Pronostico[]
}

model Partido {
  id              Int            @id @default(autoincrement())
  fase            Int            // 1 = grupos, 2 = mata-mata
  ronda           String         // "grupos", "dieciseisavos", "octavos", "cuartos", "semifinal", "tercer_puesto", "final"
  grupo           String?        // ej. "A", "B", null si es mata-mata
  equipoLocal     String         // nombre de selección
  equipoVisita    String
  fechaHora       DateTime       // en UTC
  estadio         String?
  estado          EstadoPartido  @default(PROGRAMADO)
  golesLocalReal  Int?
  golesVisitaReal Int?
  pronosticos     Pronostico[]
}

model Pronostico {
  id            Int      @id @default(autoincrement())
  usuarioId     Int
  partidoId     Int
  golesLocal    Int?
  golesVisita   Int?
  puntos        Int?     // se llena al procesar: 0, 1 o 3
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  partido Partido @relation(fields: [partidoId], references: [id])

  @@unique([usuarioId, partidoId])
}

model Configuracion {
  id    Int           @id @default(autoincrement())
  clave String        @unique
  valor String
}
